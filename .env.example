# Mẫu biến môi trường — sao chép thành .env.local và điền giá trị thật.
# Trên Vercel: Settings → Environment Variables (biến DB do tích hợp Neon tự thêm).

# --- Database (Neon Postgres, Singapore) — dùng từ P5 ---
DATABASE_URL=
POSTGRES_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=

# --- CMS (P5) ---
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=

# --- Website (P4) — URL chính thức cho sitemap, canonical, chia sẻ (để trống: dùng URL production của Vercel) ---
NEXT_PUBLIC_SITE_URL=

# --- Thông báo lead (P1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
